# FisherMart — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to app.json "extra" section when you have real credentials.
# The anon key is safe to embed in mobile apps (enforced by Row Level Security).
# NEVER use or embed the Supabase SERVICE ROLE key.
#
# How to find these values:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project
#   3. Settings → API
#   4. Copy "Project URL" and "anon / public" key
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# In app.json, set these under "extra":
#   "extra": {
#     "supabaseUrl": "https://YOUR_PROJECT_ID.supabase.co",
#     "supabaseAnonKey": "YOUR_ANON_KEY_HERE"
#   }
